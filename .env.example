# Twelve Data — get a free key at https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=
# Telegram bot — create a bot with @BotFather and get your chat id (see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secret required by GET /api/cron/check-alerts (used by Vercel Cron / external cron)
CRON_SECRET=

# Optional — price monitor interval in minutes (default: 2, like */2 * * * *)
# MONITOR_INTERVAL_MINUTES=2

# Optional — API base URL overrides (useful for local testing, see scripts/mock-apis.mjs)
# TWELVE_DATA_BASE_URL=https://api.twelvedata.com
# TELEGRAM_API_BASE=https://api.telegram.org
